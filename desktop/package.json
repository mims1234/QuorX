{
  "name": "quorx-desktop",
  "productName": "QuorX",
  "version": "0.2.15",
  "private": true,
  "license": "Apache-2.0",
  "description": "QuorX desktop: an open-source AI agent with a quorum of models behind every call, with real Chromium tabs in the pane's Browser tab.",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node make-icon.js",
    "dist": "node make-icon.js && electron-builder --win nsis --x64",
    "release": "npm version patch --no-git-tag-version && node sync-version.js && npm run dist",
    "dist:store": "node make-icon.js && electron-builder --win appx --x64"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  },
  "author": "QuorX",
  "build": {
    "appId": "dev.quorx.desktop",
    "productName": "QuorX",
    "copyright": "QuorX",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "sound.js",
      "icon.js",
      "storage.js",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "app-server",
        "filter": [
          "server.js",
          "package.json",
          "server/**/*",
          "public/**/*",
          "news/**/*",
          "design-systems/**/*",
          "models/**/*",
          "scripts/news-check.mjs",
          "skills/**/*",
          "templates/**/*",
          "extension/**/*",
          "README.md",
          "LICENSE",
          "NOTICE"
        ]
      },
      {
        "from": "../node_modules/node-pty",
        "to": "app-server/node_modules/node-pty",
        "filter": [
          "package.json",
          "lib/**/*",
          "prebuilds/win32-x64/**/*",
          "!**/*.pdb",
          "build/Release/*.node"
        ]
      },
      {
        "from": "../node_modules/@xterm/xterm",
        "to": "app-server/node_modules/@xterm/xterm",
        "filter": [
          "package.json",
          "lib/xterm.js",
          "css/**/*"
        ]
      },
      {
        "from": "../node_modules/@xterm/addon-fit",
        "to": "app-server/node_modules/@xterm/addon-fit",
        "filter": [
          "package.json",
          "lib/addon-fit.js"
        ]
      },
      {
        "from": "../node_modules/katex",
        "to": "app-server/node_modules/katex",
        "filter": [
          "package.json",
          "dist/katex.min.js",
          "dist/katex.min.css",
          "dist/fonts/**/*"
        ]
      }
    ],
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuorX",
      "runAfterFinish": true,
      "artifactName": "QuorX-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/mims1234/QuorX/releases/latest/download"
      }
    ],
    "appx": {
      "identityName": "14991MiMs.QuorX",
      "publisher": "CN=BCAF9FCC-5703-459A-9027-CD13C1B68AD9",
      "publisherDisplayName": "MiMs",
      "displayName": "QuorX",
      "applicationId": "QuorX",
      "backgroundColor": "#0b0f0d",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": false,
      "artifactName": "QuorX-Store-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "quorx": {
    "updateUrl": "https://github.com/mims1234/QuorX/releases/latest/download",
    "_note": "Set updateUrl to where you publish releases (the files in dist: latest.yml, QuorX-Setup-<version>.exe and its .blockmap), e.g. https://github.com/<you>/<repo>/releases/latest/download. Users can change it in Settings → About.",
    "winget": {
      "packageIdentifier": "QuorX.QuorX",
      "publisher": "QuorX",
      "publisherUrl": "https://github.com/mims1234",
      "packageUrl": "https://github.com/mims1234/QuorX",
      "license": "Apache-2.0",
      "licenseUrl": "https://github.com/mims1234/QuorX/blob/main/LICENSE",
      "downloadBase": "https://github.com/mims1234/QuorX/releases/download/v{version}",
      "_note": "For npm run winget (scripts/winget-manifest.mjs). downloadBase must be a permanent per-version https address with {version}, e.g. https://github.com/<you>/<repo>/releases/download/v{version}. Empty: a GitHub releases/latest/download updateUrl is turned into that."
    }
  },
  "homepage": "https://github.com/mims1234/QuorX"
}
