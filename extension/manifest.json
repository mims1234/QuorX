{
  "manifest_version": 3,
  "name": "QuorX",
  "version": "0.3.5",
  "description": "Lets a QuorX chat open its own tabs in your everyday Chrome and work there with your sign-ins. It touches only the tabs it opened.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "storage", "alarms", "scripting", "tabGroups"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "QuorX in Chrome", "default_popup": "popup.html", "default_icon": { "16": "icons/quorx-16.png", "32": "icons/quorx-32.png" } },
  "commands": { "stop-agent": { "suggested_key": { "default": "Alt+Shift+Q" }, "description": "Stop the QuorX agent working in your Chrome" } },
  "icons": { "16": "icons/quorx-16.png", "32": "icons/quorx-32.png", "48": "icons/quorx-48.png", "128": "icons/quorx-128.png" }
}
